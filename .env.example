# Sarvam AI key from https://dashboard.sarvam.ai
SARVAM_API_KEY=your-sarvam-key
SARVAM_MODEL=sarvam-105b

# Gmail search that matches your college's emails (change the domain!)
COLLEGE_QUERY=from:(@yourcollege.edu.in)
LOOKBACK_HOURS=24
TIMEZONE=Asia/Kolkata
CALENDAR_ID=primary
# Leave empty to send the digest to your own Gmail
DIGEST_TO=
