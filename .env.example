# Sarvam AI key from https://dashboard.sarvam.ai
SARVAM_API_KEY=your-sarvam-key
SARVAM_MODEL=sarvam-105b

# Morning Bell reports on ALL mail from the last LOOKBACK_HOURS.
# Optional extra Gmail search to narrow it, e.g.  MAIL_QUERY=-category:promotions
MAIL_QUERY=
# Max emails per report
MAX_EMAILS=60
LOOKBACK_HOURS=24
TIMEZONE=Asia/Kolkata
CALENDAR_ID=primary
# Leave empty to send the report to your own Gmail
DIGEST_TO=
