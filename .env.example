# Sarvam AI key from https://dashboard.sarvam.ai
SARVAM_API_KEY=your-sarvam-key
SARVAM_MODEL=sarvam-105b

# Which Gmail emails to check. This is a normal Gmail search, so keywords work.
# Default: any email mentioning schedule-related words.
# Optional, more precise: add a sender, e.g. from:(professor@gmail.com OR college.edu) (exam OR exams OR class OR lecture OR lab OR quiz OR assignment OR deadline OR timetable OR schedule OR rescheduled OR cancelled OR viva OR seminar OR submission OR semester)
COLLEGE_QUERY=(exam OR exams OR class OR lecture OR lab OR quiz OR assignment OR deadline OR timetable OR schedule OR rescheduled OR cancelled OR viva OR seminar OR submission OR semester)
LOOKBACK_HOURS=24
TIMEZONE=Asia/Kolkata
CALENDAR_ID=primary
# Leave empty to send the digest to your own Gmail
DIGEST_TO=
